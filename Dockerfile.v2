FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-v2.txt pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-v2.txt

COPY src ./src
COPY migrations_v2 ./migrations_v2
COPY alembic_v2.ini ./
COPY scripts_v2 ./scripts_v2

RUN chmod +x /app/scripts_v2/*.sh \
    && useradd --create-home --uid 10001 loyalty \
    && chown -R loyalty:loyalty /app
USER loyalty

CMD ["uvicorn", "loyalty_v2.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
