# PostgreSQL container
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=loyalty_v2

# V2 application (Settings uses LOYALTY_ prefix)
LOYALTY_ENVIRONMENT=production
LOYALTY_DATABASE_URL=postgresql+asyncpg://loyalty:replace-with-strong-password@db:5432/loyalty_v2
LOYALTY_PIN_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
LOYALTY_IDENTIFICATION_CODE_SECRET=replace-with-another-32-random-characters
LOYALTY_INTEGRATION_API_KEY_SECRET=replace-with-another-32-random-characters
LOYALTY_CLIENT_BOT_TOKEN=
LOYALTY_STAFF_BOT_TOKEN=
LOYALTY_ORGANIZATION_ID=
